{
  "name": "cc-relay",
  "productName": "CC Relay",
  "version": "0.2.38",
  "private": true,
  "type": "module",
  "main": "src/electron-main.mjs",
  "description": "Local task orchestration for subscription-authenticated Codex and Claude Code sessions.",
  "author": "Patrik Kelemen",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crowie-s-r-o/CC-Relay.git"
  },
  "homepage": "https://github.com/Crowie-s-r-o/CC-Relay#readme",
  "bugs": {
    "url": "https://github.com/Crowie-s-r-o/CC-Relay/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "desktop": "electron .",
    "desktop:build:mac": "electron-builder --mac --publish never",
    "desktop:build:win": "electron-builder --win --publish never",
    "icon:mac": "node scripts/generate-mac-icon.mjs",
    "test": "node --test",
    "deploy": "node scripts/deploy.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "attribution:check": "node scripts/check-commit-attribution.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "plugin:install": "node scripts/install-plugin.mjs",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
